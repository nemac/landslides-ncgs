{
  "name": "landslides-ncgs",
  "private": true,
  "description": "Landslides in Western North Carolina site and SIREN alerts dashboard. Static HTML/CSS/JS; this package only holds lint and format tooling.",
  "scripts": {
    "lint": "eslint alerts/js",
    "lint:fix": "eslint alerts/js --fix",
    "format": "prettier --write \"alerts/js/**/*.js\" \"alerts/css/**/*.css\"",
    "format:check": "prettier --check \"alerts/js/**/*.js\" \"alerts/css/**/*.css\"",
    "lint:py": "ruff check scripts",
    "format:py": "ruff format scripts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
