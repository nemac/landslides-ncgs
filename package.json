{
  "name": "landslides-ncgs",
  "private": true,
  "description": "Landslides in Western North Carolina site and SIREN alerts dashboard. Static HTML/CSS/JS; this package only holds lint and format tooling.",
  "scripts": {
    "lint": "eslint alerts/js simple/js simple/test simple/e2e infra/cloudfront infra/preview",
    "lint:fix": "eslint alerts/js simple/js simple/test simple/e2e infra/cloudfront infra/preview --fix",
    "test:simple": "node --test \"simple/test/*.test.js\"",
    "test:e2e": "playwright test --config simple/e2e/playwright.config.js",
    "format": "prettier --write \"alerts/**/*.{js,css}\" \"simple/**/*.{js,css}\" \"infra/cloudfront/**/*.js\" \"infra/preview/**/*.js\" \"infra/cdk/{bin,lib,test}/**/*.ts\"",
    "format:check": "prettier --check \"alerts/**/*.{js,css}\" \"simple/**/*.{js,css}\" \"infra/cloudfront/**/*.js\" \"infra/preview/**/*.js\" \"infra/cdk/{bin,lib,test}/**/*.ts\"",
    "lint:py": "ruff check scripts simple/pipeline infra/lambda",
    "format:py": "ruff format scripts simple/pipeline infra/lambda",
    "format:py:check": "ruff format --check scripts simple/pipeline infra/lambda"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.4.2"
  }
}
